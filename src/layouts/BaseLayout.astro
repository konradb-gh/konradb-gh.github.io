---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Thoughts on markets, money, and building things.' } = Astro.props;
// Shortened to first name only for now — change back to 'Konrad Boguszewski' later.
const siteTitle = 'Tick & Tale';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · {siteTitle}</title>
    <!-- Cloudflare Web Analytics -->
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "4aeb3efd59064c48b7a4108d4cebfb2f"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </head>
  <body>
    <header class="site-header">
      <div class="wrapper">
        <div class="brand-group">
          <a class="brand" href="/">{siteTitle}</a>
          <details class="about">
            <summary>About</summary>
            <div class="about-panel">
              <p>
                I'm Konrad — former Senior Market Data Analyst at the London
                Stock Exchange Group, based in Venice, studying economics,
                writing about financial markets.
              </p>
            </div>
          </details>
        </div>
        <nav>
          <a href="/">Home</a>
          <a href="https://www.youtube.com/@TickTaleK" target="_blank" rel="noopener">YouTube</a>
        </nav>
      </div>
    </header>

    <main class="wrapper">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrapper">
        <p class="disclaimer">Not financial advice. For informational purposes only.</p>
      </div>
    </footer>
  </body>
</html>
