---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Thoughts on markets, money, and building things.' } = Astro.props;
// Shortened to first name only for now — change back to 'Konrad Boguszewski' later.
const siteTitle = 'Konrad';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · {siteTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrapper">
        <div class="brand-group">
          <a class="brand" href="/">{siteTitle}</a>
          <details class="about">
            <summary>About</summary>
            <div class="about-panel">
              <p>
                I write about markets, technology, and the occasional
                supply-chain rant — plainly, without hedging every sentence
                into mush. Anything here that touches money is me thinking
                out loud, not a recommendation. See the footer on every page
                — I mean it.
              </p>
            </div>
          </details>
        </div>
        <nav>
          <a href="/">Home</a>
        </nav>
      </div>
    </header>

    <main class="wrapper">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrapper">
        <p class="disclaimer">Not financial advice. For informational purposes only.</p>
      </div>
    </footer>
  </body>
</html>
