---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const marketsPosts = allPosts.filter((post) => post.data.category === 'markets');
const experimentsPosts = allPosts.filter((post) => post.data.category === 'experiments');
// Glossary reads as a reference index, not a news feed, so it's numbered
// oldest-first (order added) rather than newest-first like the other tabs.
const glossaryPosts = allPosts.filter((post) => post.data.category === 'glossary').reverse();
const recentPosts = allPosts.slice(0, 5);
---

<BaseLayout title="Home">
  <div class="category-tabs" role="tablist">
    <button type="button" class="category-tab is-active" data-category="markets" role="tab" aria-selected="true">
      Markets
    </button>
    <button type="button" class="category-tab" data-category="experiments" role="tab" aria-selected="false">
      My Experiments
    </button>
    <button type="button" class="category-tab" data-category="glossary" role="tab" aria-selected="false">
      Glossary
    </button>
  </div>

  <p class="methodology-note" data-panel="experiments" hidden>
    The goal here is to find out which trading and investment ideas actually
    hold up under honest testing, from short-term trading rules to long-term
    portfolio construction. Every experiment is created, tested, and
    simulated on my own machine, entirely in Python, against decades of real
    daily price data — most experiments span 1996 to today, and the core
    system's own backtest covers more than four decades, back to 1982. Full
    code, data, and reproduction steps for every experiment are published in
    the <a href="https://github.com/konradb-gh/trading-research">trading-research repo</a>.
  </p>

  <ul class="post-list" data-panel="markets">
    {
      marketsPosts.map((post) => (
        <li>
          <h2>
            <a href={`/blog/${post.data.slug}/`}>{post.data.title}</a>
          </h2>
          <p class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: '2-digit',
              })}
            </time>
            <span class="tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </span>
          </p>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>

  <ul class="post-list" data-panel="experiments" hidden>
    {
      experimentsPosts.map((post) => (
        <li>
          <h2>
            <a href={`/blog/${post.data.slug}/`}>{post.data.title}</a>
          </h2>
          <p class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: '2-digit',
              })}
            </time>
            <span class="tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </span>
          </p>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>

  <ul class="post-list" data-panel="glossary" hidden>
    {
      glossaryPosts.map((post) => (
        <li>
          <h2>
            <a href={`/blog/${post.data.slug}/`}>{post.data.title}</a>
          </h2>
          <p class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: '2-digit',
              })}
            </time>
            <span class="tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </span>
          </p>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>

  <Sidebar recentPosts={recentPosts} totalCount={allPosts.length} />

  <script>
    const tabs = document.querySelectorAll('.category-tab');
    const panels = document.querySelectorAll('[data-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const category = tab.getAttribute('data-category');

        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', String(active));
        });

        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute('data-panel') !== category;
        });
      });
    });
  </script>
</BaseLayout>
